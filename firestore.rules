rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'hyprpranav@gmail.com' && getRole() == 'admin';
    }

    function isManagerOrAdmin() {
      return isAuthenticated() && (getRole() == 'manager' || getRole() == 'admin');
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // USERS COLLECTION
    match /users/{userId} {
      // Any authenticated user can read their own doc
      // Admins and managers can read all user docs
      allow read: if isOwner(userId) || isManagerOrAdmin();

      // Workers/managers register as pending (isActive: false, role: worker/manager)
      allow create: if isOwner(userId) && request.resource.data.role in ['manager', 'worker'] && request.resource.data.isActive == false
        // Bootstrap: allow the admin email to create/own their admin doc
        || (isAuthenticated() && request.auth.uid == userId && request.auth.token.email == 'hyprpranav@gmail.com');

      // Only admin can update others; admin email can always update own doc (bootstrap)
      allow update: if isAdmin()
        || (isManagerOrAdmin() && resource.data.role == 'worker' && request.resource.data.role == 'worker')
        || (isAuthenticated() && request.auth.uid == userId && request.auth.token.email == 'hyprpranav@gmail.com');

      allow delete: if isAdmin() || (isManagerOrAdmin() && resource.data.role == 'worker');
    }

    // WORKERS COLLECTION
    match /workers/{workerId} {
      allow read: if isAuthenticated() || resource.data.status == 'active';
      allow create: if isManagerOrAdmin();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow delete: if isManagerOrAdmin();
    }

    match /managers/{managerId} {
      allow read: if isManagerOrAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /adminSettings/{settingId} {
      allow read, write: if isManagerOrAdmin();
    }

    // EXPOSURE RECORDS
    match /exposureRecords/{recordId} {
      // Managers/admins can read all records.
      // Workers can read their own records (workerId field stores the Firestore doc ID of the worker,
      // so we join back to the workers collection to verify the authenticated UID matches).
      allow read: if isManagerOrAdmin()
        || (isAuthenticated() && (
          get(/databases/$(database)/documents/workers/$(resource.data.workerId)).data.uid == request.auth.uid
        ))
        || resource.data.isPublicVisible == true;

      // Managers/admins can always create exposure records.
      // Workers can create records for themselves — verified by checking the worker doc's uid field
      // matches the authenticated user's uid.
      allow create: if isManagerOrAdmin()
        || (isAuthenticated() && exists(/databases/$(database)/documents/workers/$(request.resource.data.workerId))
            && get(/databases/$(database)/documents/workers/$(request.resource.data.workerId)).data.uid == request.auth.uid);

      // Only managers/admins can delete exposure records
      allow update: if isAdmin();
      allow delete: if isManagerOrAdmin();
    }

    // WORKER REQUESTS
    match /workerRequests/{requestId} {
      allow create: if true;
      allow read: if isManagerOrAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow update, delete: if isManagerOrAdmin();
    }

    match /managerRequests/{requestId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // AUDIT LOGS
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isManagerOrAdmin();
      allow update, delete: if false;
    }

    // CALIBRATION MODELS
    match /calibrationModels/{modelId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // QR RECORDS
    match /qrRecords/{recordId} {
      allow read, write: if isManagerOrAdmin();
    }

    // PHOTO SNAPSHOTS
    match /photoSnapshots/{snapshotId} {
      allow create: if isAuthenticated();
      allow read: if isManagerOrAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // SCAN APPROVALS (Worker-to-worker dosimeter scans awaiting Manager/Admin approval)
    match /scanApprovals/{approvalId} {
      allow create: if isAuthenticated();
      allow read: if isManagerOrAdmin() || (isAuthenticated() && (resource.data.scannerUid == request.auth.uid || resource.data.targetWorkerUid == request.auth.uid));
      allow update, delete: if isManagerOrAdmin();
    }
  }
}

