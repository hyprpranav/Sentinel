rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'hyprpranav@gmail.com' && getRole() == 'admin';
    }

    function isManagerOrAdmin() {
      return isAuthenticated() && (getRole() == 'manager' || getRole() == 'admin');
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // USERS COLLECTION
    match /users/{userId} {
      // Any authenticated user can read their own doc
      // Admins and managers can read all user docs
      allow read: if isOwner(userId) || isManagerOrAdmin();

      // Workers/managers register as pending (isActive: false, role: worker/manager)
      allow create: if isOwner(userId) && request.resource.data.role in ['manager', 'worker'] && request.resource.data.isActive == false
        // Bootstrap: allow the admin email to create/own their admin doc
        || (isAuthenticated() && request.auth.uid == userId && request.auth.token.email == 'hyprpranav@gmail.com');

      // Only admin can update others; admin email can always update own doc (bootstrap)
      allow update: if isAdmin()
        || (isAuthenticated() && request.auth.uid == userId && request.auth.token.email == 'hyprpranav@gmail.com');

      allow delete: if isAdmin();
    }

    // WORKERS COLLECTION
    match /workers/{workerId} {
      allow read: if isAuthenticated() || resource.data.status == 'active';
      allow create: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /managers/{managerId} {
      allow read: if isManagerOrAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /adminSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    // EXPOSURE RECORDS
    match /exposureRecords/{recordId} {
      allow read: if isManagerOrAdmin()
        || (isAuthenticated() && resource.data.workerId == request.auth.uid)
        || resource.data.isPublicVisible == true;
      allow create: if isManagerOrAdmin() || (isAuthenticated() && request.resource.data.workerId == request.auth.uid);
      allow update, delete: if false;
    }

    // WORKER REQUESTS
    match /workerRequests/{requestId} {
      allow create: if true;
      allow read: if isManagerOrAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /managerRequests/{requestId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // AUDIT LOGS
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isManagerOrAdmin();
      allow update, delete: if false;
    }

    // CALIBRATION MODELS
    match /calibrationModels/{modelId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // QR RECORDS
    match /qrRecords/{recordId} {
      allow read, write: if isManagerOrAdmin();
    }

    // PHOTO SNAPSHOTS
    match /photoSnapshots/{snapshotId} {
      allow create: if isAuthenticated();
      allow read: if isManagerOrAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}

